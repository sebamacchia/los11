# DIN es de Linotype/Apple: no se redistribuye (está en macOS)
animaciones/**/assets/fonts/din-*.ttf

# originales con logo (sacados de transmisiones)
animaciones/**/assets/_con_logo/

# cuadros de transmisiones del manual web (están publicados en el artifact)
